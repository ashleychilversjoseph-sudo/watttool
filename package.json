{
  "name": "watttool",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first electrical calculators and job notes for mobile and web",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --configLoader runner",
    "check": "tsc -b && vitest run --configLoader runner",
    "cap:add:android": "cap add android",
    "cap:sync": "pnpm build && cap sync android",
    "android:debug": "pnpm cap:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "pnpm cap:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.19.0"
}
